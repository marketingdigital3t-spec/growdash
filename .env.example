# Front-end public environment variables
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-publishable-key"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"
VITE_SUPABASE_PROJECT_ID="your-project-ref"

# Supabase Edge Function secrets
# Configure these in Supabase Dashboard > Project Settings > Edge Functions > Secrets.
# Do not expose service role keys or provider API tokens in Vite variables.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
AI_API_URL="https://api.openai.com/v1/chat/completions"
AI_API_KEY="your-server-side-ai-key"
AI_MODEL="gpt-4.1-mini"
WHATSAPP_APP_SECRET="your-whatsapp-meta-app-secret"

# Sentry runtime metadata (DSN is configured as a Supabase secret for Edge
# Functions; the release is injected by CI and never hard-coded in source).
SENTRY_DSN="https://public-key@example.ingest.sentry.io/project-id"
SENTRY_ENVIRONMENT="production"
SENTRY_RELEASE="local"

# Provider/API tokens must be stored server-side only.
# Meta/RD/WhatsApp tokens should be saved through secure backend flows,
# preferably encrypted or stored with Supabase Vault.
